# ============================================================
# Timesheet Monorepo – Production Environment Configuration
# ============================================================
# Copy this file to .env on your server:
#   cp .env.example .env
# ============================================================

# ---------------------------
# Database (External PostgreSQL)
# ---------------------------
# Format: postgresql+asyncpg://<username>:<password>@<db-host>:5432/<database_name>?ssl=require
# Examples: Supabase, Neon, AWS RDS, Render, etc.
DATABASE_URL=postgresql+asyncpg://postgres:your_password@your_external_db_host:5432/timesheet_db?ssl=require

# ---------------------------
# JWT / Security
# ---------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=change_me_to_a_random_32_character_string_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------
# Default Admin Email
# ---------------------------
ADMIN_EMAIL=admin@yourcompany.com

# ---------------------------
# CORS (Optional: leave default unless accessing API directly from another external domain)
# ---------------------------
FRONTEND_URLS=["http://localhost","http://127.0.0.1"]

# ---------------------------
# Google OAuth (Optional)
# ---------------------------
GOOGLE_CLIENT_ID=

# ---------------------------
# SMTP Email Notifications (Optional)
# ---------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
