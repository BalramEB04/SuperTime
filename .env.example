# ============================================================
# SuperTime Monorepo — Production Environment Configuration
# ============================================================
# Copy this file to .env on your deployment server:
#   cp .env.example .env
# ============================================================

# ---------------------------
# Database (External PostgreSQL 15+)
# ---------------------------
# Format: postgresql+asyncpg://<username>:<password>@<db-host>:5432/<database_name>?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres:your_password@db-host:5432/timesheet_db?ssl=require
# Unpooled/direct connection for migrations (Neon / PgBouncer):
DATABASE_URL_UNPOOLED=postgresql+asyncpg://postgres:your_password@db-host:5432/timesheet_db?ssl=require

# ---------------------------
# JWT / Security
# ---------------------------
# Generate a secure 32+ character key: openssl rand -hex 32
SECRET_KEY=your_generated_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------
# Frontend Port (Default: 3000 for Google SSO compatibility, set to 80 on production servers)
# ---------------------------
FRONTEND_PORT=3000

# ---------------------------
# Default Admin Email
# ---------------------------
ADMIN_EMAIL=admin@yourcompany.com

# ---------------------------
# CORS / Allowed Frontend URLs (JSON Array format)
# ---------------------------
FRONTEND_URLS=["http://localhost","https://timesheet.yourdomain.com"]

# ---------------------------
# Google OAuth (Required for Google SSO)
# ---------------------------
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# ---------------------------
# SMTP Email Notifications (Optional)
# ---------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@yourcompany.com
SMTP_PASSWORD=your_email_app_password

